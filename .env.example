# Supabase Postgres connection strings (Project Settings -> Database).
# DATABASE_URL: the "Transaction" pooler connection (port 6543) — used at runtime.
# DIRECT_URL: the "Session"/direct connection (port 5432) — used by Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# Optional: IPinfo token for more accurate IP geolocation in production.
# Without it, the demo falls back to the free ip-api.com lookup.
IPINFO_TOKEN=

# Initial admin account (used by `npm run create-admin`)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Session cookie signing — not currently used for signing (sessions are
# opaque random tokens stored in Postgres), reserved for future use.
SESSION_SECRET=
